# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed for your local setup.
# Never commit the .env file containing real secrets to version control.
# ==============================================================================

# Apache Cassandra Configuration
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=ev_analytics
CASSANDRA_USERNAME=cassandra
CASSANDRA_PASSWORD=cassandra
CASSANDRA_DATACENTER=datacenter1

# Apache Spark Configuration
SPARK_APP_NAME=EVChargingStationAnalytics
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Data Paths
DATA_RAW_PATH=data/raw/ChargingRecords.csv
DATA_PROCESSED_PATH=data/processed

# Streamlit Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
